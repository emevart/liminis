# Rust
/target

# Cargo.lock is committed on purpose: this workspace ships a binary,
# and the exact dependency set is part of run reproducibility (ADR-020).

# macOS
.DS_Store

# Claude Code local overrides
.claude/settings.local.json

# Secrets. The crates.io token belongs in ~/.cargo/credentials.toml via
# `cargo login`, not in the working tree — but a stray .env should never be
# one `git add -A` away from the public history.
.env
.env.*

# Run outputs
/runs

# Snapshots
*.snap
